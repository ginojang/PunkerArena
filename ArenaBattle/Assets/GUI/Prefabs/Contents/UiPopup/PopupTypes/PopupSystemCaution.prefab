  m_Text: "\uC785\uB825\uD558\uC2E0 ID\uAC00 \uD2C0\uB9AC\uAC70\uB098 \uC874\uC7AC\uD558\uC9C0
    \uC54A\uC544\r \n\uD638\uB450 \uC789\uAE00\uB9AC\uC2DC\uC5D0 \uC811\uC18D\uD560
