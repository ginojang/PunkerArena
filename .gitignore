# Ignored: FruttiDino RPG working folder (분석 기록용, 버전관리 제외)
/FruttiDino_RPG/

# =========================================================
# Unity (ArenaBattle 등 Unity 프로젝트 공통) — 자동 생성물 제외
# =========================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
# Exception: Assets/Editor/Build/ holds build *scripts* (source), not build output
!ArenaBattle/Assets/Editor/Build/
!ArenaBattle/Assets/Editor/Build/**
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data는 폴더가 통째로 무시될 때만 제외
!/[Aa]ssets/**/*.meta

# Unity가 생성하는 솔루션/프로젝트 파일 (재생성됨)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D 생성 메타/캐시
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
.vs/
.vsconfig

# Rider / VS Code
.idea/
.vscode/

# 크래시 리포트
crashlytics-build.properties

# Addressables build output (regenerable via ArenaBuildTools.BuildAddressables)
/ArenaBattle/HostedData/
